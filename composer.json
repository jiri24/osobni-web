{
    "require": {
        "tightenco/jigsaw": "^1.8"
    },
    "scripts": {
        "build": "jigsaw build",
        "serve": "jigsaw serve",
        "watch": "jigsaw build local --watch",
        "dev": [
            "npm run dev"
        ],
        "start": "npx concurrently \"npm run dev\" \"jigsaw serve\"",
